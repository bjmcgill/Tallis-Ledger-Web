# ============================================================
# Tallis Ledger Web — .gitignore
# React/Vite (client) + Node.js/Express (server) monorepo
# ============================================================

# --- Dependencies ---
node_modules/
client/node_modules/
server/node_modules/

# --- Build output ---
client/dist/
client/build/
server/dist/

# --- Environment variables (NEVER commit these) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
client/.env
server/.env
server/.env.production

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/settings.json
.idea/

# --- Deployment artefacts ---
*.zip
deploy-zip.bat.bak

# --- Vite cache ---
client/.vite/

# --- MySQL / database dumps ---
*.sql
*.dump

# --- Misc ---
*.bak
*.tmp
.cache/
